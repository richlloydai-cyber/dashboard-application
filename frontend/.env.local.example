# ============================================================
# HERMES DASHBOARD - Frontend Environment (local clone workflow)
# Copy this file to .env.local and fill in your tunnel URL.
#   cp .env.local.example .env.local
# ============================================================

# The public URL of the Hermes adapter API (the cloudflared tunnel).
# Get this from whoever is running the Hermes adapter; it looks like:
#   https://random-words-here.trycloudflare.com
# Leave NEXT_PUBLIC_DASHBOARD_PATH unset so the app serves at http://localhost:3000
NEXT_PUBLIC_API_URL=https://REPLACE-ME.trycloudflare.com

# Optional: Server-Sent Events endpoint for live updates (same host as the API).
# NEXT_PUBLIC_WS_URL is unused in local mode (the adapter uses SSE, not WS).

# ------------------------------------------------------------
# DEPLOYMENT-ONLY (leave unset for local dev)
# Set these ONLY when serving behind nginx under a subpath:
#   NEXT_PUBLIC_DASHBOARD_PATH=/projects
#   NEXT_PUBLIC_API_URL=/projects/api
# ------------------------------------------------------------

NEXT_TELEMETRY_DISABLED=1
